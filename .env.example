# SG-SST Configuración de entorno
# Copia este archivo a .env y ajusta los valores

# Servidor
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Base de datos (SQLite)
# Las rutas relativas se resuelven contra la raíz del repositorio.
# SG_SST_DATA_DIR (directorio) tiene prioridad sobre DB_PATH (archivo).
# DB_PATH=./data/sg-sst.db
SG_SST_DATA_DIR=./data

# DB_BACKEND: motor activo de la aplicación.
#   sqlite (por defecto): desarrollo y pruebas.
#   pg: PostgreSQL (recomendado para el despliegue local en producción).
# DB_BACKEND=sqlite

# ============================================================
# BASE DE DATOS POSTGRESQL LOCAL (despliegue local)
# ============================================================
# Con DB_BACKEND=pg, la aplicación usa PostgreSQL y no abre SQLite.
# Crear la base y el usuario de aplicación con permisos mínimos:
#   createdb sg_sst
#   psql -c "CREATE ROLE sg_sst_app LOGIN PASSWORD '...';"
# Ejemplo de cadena local:
# DB_BACKEND=pg
# DATABASE_URL=postgresql://sg_sst_app:contraseña@127.0.0.1:5432/sg_sst
# PGPOOL_MAX=5
# Aplicar migraciones: pnpm --dir server run migrate:pg
# Para pruebas/CI usar TEST_DATABASE_URL con una base separada.
# DATABASE_URL=
# TEST_DATABASE_URL=

# Sesión / JWT
SESSION_SECRET=cambia-esto-en-produccion-por-algo-seguro-generado-con-crypto

# Semilla inicial (ejecutar una vez)
SEED=false

# ============================================================
# DESPLIEGUE LOCAL: HTTPS, PROXY, ALERTAS Y RESPALDOS
# ============================================================
# El despliegue local no envía correo: las alertas se generan en el panel,
# se consultan y se marcan como atendidas dentro de la aplicación.

# URL interna publicada por Caddy
# FRONTEND_URL=https://sg-sst.local
# Cookies solo bajo HTTPS (activar en el equipo dedicado)
# COOKIE_SECURE=true
# Confiar en el proxy inverso (Caddy) para IP y protocolo reales
# TRUST_PROXY=true

# Activar generación diaria de alertas (07:00 America/Bogota), solo panel
ALERTS_ENABLED=true

# Configuración de respaldo automático
BACKUP_ENABLED=true
BACKUP_TIMEZONE=America/Bogota
# Días de retención de backups sg-sst-pg-backup-* (backend PostgreSQL)
BACKUP_RETENTION_DAYS=30
# Carpeta de respaldos en disco externo o NAS; nunca en el SSD del sistema.
# Se valida que exista o se pueda crear y que tenga al menos 200 MB libres.
# BACKUP_DIR=D:/respaldos-sg-sst
# UPLOADS_DIR=./uploads

# Clave de cifrado para datos sensibles (Ley 1581/2012 - datos médicos en reposo)
# Usar el mismo valor en todos los entornos que compartan la base de datos
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=generar-con-node-crypto-en-produccion