# SG-SST Configuración de entorno
# Copia este archivo a .env y ajusta los valores

# Servidor
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Base de datos (SQLite)
# Las rutas relativas se resuelven contra la raíz del repositorio.
# SG_SST_DATA_DIR (directorio) tiene prioridad sobre DB_PATH (archivo).
# DB_PATH=./data/sg-sst.db
SG_SST_DATA_DIR=./data

# DB_BACKEND: motor activo de la aplicación (Fase N2, transición N2-N3).
#   sqlite (por defecto): comportamiento actual, pruebas y operación sin cambios.
#   pg: empresas, usuarios, roles, autenticación y bitácora usan Postgres vía DATABASE_URL.
# DB_BACKEND=sqlite

# ============================================================
# BASE DE DATOS EN LA NUBE (Neon PostgreSQL)
# ============================================================
# Cadena de conexión del proyecto Neon (Dashboard > Connection Details).
# Usar la cadena "pooled" (incluye "-pooler") para la aplicación.
# Ejemplo:
# DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/sg-sst?sslmode=require
#
# Para pruebas/CI crear un branch en Neon y usar su propia cadena (DATABASE_URL_DEV).
# La cadena debe iniciar con postgresql:// y trae sslmode=require: el TLS
# queda activo con validación completa del certificado.
# DATABASE_URL=
# DATABASE_URL_DEV=

# Sesión / JWT
SESSION_SECRET=cambia-esto-en-produccion-por-algo-seguro-generado-con-crypto

# Semilla inicial (ejecutar una vez)
SEED=false

# ============================================================
# CONFIGURACIÓN SMTP PARA ALERTAS AUTOMÁTICAS
# ============================================================
# Si no se configura, el sistema funciona en MODO SIMULACIÓN (logs en consola)
#
# Gmail (usar App Password, no la contraseña normal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alertas@tuempresa.com
# SMTP_PASS=tu_app_password_de_16_caracteres
# SMTP_FROM=SG-SST Alertas <alertas@tuempresa.com>
#
# Outlook/Office365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=alertas@tuempresa.com
# SMTP_PASS=tu_contraseña
# SMTP_FROM=SG-SST Alertas <alertas@tuempresa.com>
#
# Proveedor genérico (ej. Mailgun, SendGrid, etc.):
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_USER=tu_usuario
# SMTP_PASS=tu_contraseña
# SMTP_FROM=SG-SST Alertas <alertas@tuempresa.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SG-SST Alertas <alertas@empresa.com>

# Activar scheduler de alertas (diario 07:00 + semanal lunes 08:00)
# Requiere NODE_ENV=production y SMTP configurado para envío real
ALERTS_ENABLED=true

# Email del administrador para resumen semanal (opcional, usa company.email por defecto)
ADMIN_EMAIL=

# Configuración de respaldo automático
BACKUP_ENABLED=true
BACKUP_TIMEZONE=America/Bogota

# Clave de cifrado para datos sensibles (Ley 1581/2012 - datos médicos en reposo)
# Usar el mismo valor en todos los entornos que compartan la base de datos
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=generar-con-node-crypto-en-produccion