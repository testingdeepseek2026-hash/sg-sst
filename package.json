{
  "name": "sg-sst-micro",
  "version": "1.0.0",
  "private": true,
  "description": "SG-SST para microempresa de servicios de instalacion electronica (CCTV, alarmas, control de acceso, cableado). Colombia.",
  "scripts": {
    "dev:api": "pnpm --dir server run dev",
    "dev:web": "pnpm --dir web run dev",
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "build": "pnpm --dir web run build && pnpm --dir server run build",
    "start": "pnpm --dir server run start",
    "seed": "pnpm --dir server run seed",
    "reset": "pnpm --dir server run reset",
    "test": "pnpm --dir server run test && pnpm --dir web run test",
    "test:watch": "concurrently \"pnpm --dir server run test:watch\" \"pnpm --dir web run test:watch\"",
    "test:coverage": "pnpm --dir server run test:coverage && pnpm --dir web run test:coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm --dir server run typecheck && pnpm --dir web run typecheck",
    "prepare": "husky install",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "4.1.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "pnpm@9.15.0"
}
